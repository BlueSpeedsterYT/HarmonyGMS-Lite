/// @description Animate

switch (cursor)
{
	case CHARACTER.SONIC:
	{
		animation_set(global.ani_css_sonic_portrait);
		break;
	}
	case CHARACTER.TAILS:
	{
		animation_set(global.ani_css_tails_portrait);
		break;
	}
	case CHARACTER.KNUCKLES:
	{
		animation_set(global.ani_css_knuckles_portrait);
		break;
	}
}